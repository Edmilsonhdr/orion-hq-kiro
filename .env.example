# Postgres do Neon. Formato (via Vercel Marketplace / painel do Neon):
#   postgresql://<usuario>:<senha>@<host>-pooler.<regiao>.aws.neon.tech/<banco>?sslmode=require
# Use o endpoint do pooler (…-pooler…) para conexões curtas de função serverless.
DATABASE_URL=postgresql://usuario:senha@ep-exemplo-pooler.us-east-1.aws.neon.tech/orion?sslmode=require

# Chave da API da Anthropic.
ANTHROPIC_API_KEY=sk-ant-...

# Modelos: principal (orquestrador/especialistas) e worker (tarefas curtas/baratas).
ORION_MODEL=claude-sonnet-5
ORION_WORKER_MODEL=claude-haiku-4-5

# Usuários no formato usuario:senha separados por vírgula.
ORION_USERS=dimi:<senha>,jullyana:<senha>
# Quem pode aprovar ações sensíveis (subconjunto de ORION_USERS).
ORION_APPROVERS=dimi,jullyana
# Segredo aleatório longo para assinar o cookie de sessão (HMAC).
ORION_SESSION_SECRET=<aleatório longo>

# Token só-leitura do repositório do Orion (para ler arquivos de PRs).
GITHUB_TOKEN=<token só leitura do repo do Orion>
# Opcional: token de outro dono (ex.: a organização). Dono "minha-org" → GITHUB_TOKEN_MINHA_ORG
# GITHUB_TOKEN_MINHA_ORG=<token só leitura dos repos da organização>
# Segredo configurado no webhook do GitHub (valida X-Hub-Signature-256).
GITHUB_WEBHOOK_SECRET=<segredo do webhook>
# Segredo que a Vercel envia como Bearer nas chamadas de cron.
CRON_SECRET=<a Vercel envia como Bearer no cron>

# URL pública do Orion HQ, para links absolutos (ex.: arquivo .ics da reunião).
# Opcional na Vercel: sem ela, usa VERCEL_PROJECT_PRODUCTION_URL (definida pela Vercel).
# Local: http://localhost:3000
ORION_BASE_URL=
